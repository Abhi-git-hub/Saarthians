{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saarthians-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "saarthians.online/login", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/login/*", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/app", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/app/*", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/teacher", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/teacher/*", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/admin", "zone_name": "saarthians.online" },
    { "pattern": "saarthians.online/admin/*", "zone_name": "saarthians.online" }
  ]
}
