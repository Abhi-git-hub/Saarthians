{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saarthians",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "saarthians-production"
    }
  }
}
