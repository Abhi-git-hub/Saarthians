# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Groq AI tutor (server-only; never prefix with NEXT_PUBLIC_).
# Production must use the deployment platform's encrypted secret store.
# Chat model override chain: GROQ_CHAT_MODEL, else OPENAI_MODEL,
# else openai/gpt-oss-20b. Base URL chain: GROQ_BASE_URL, else
# OPENAI_BASE_URL, else https://api.groq.com/openai/v1
# NOTE: this Groq account exposes chat models only (no /embeddings), so
# retrieval uses authorized pg_trgm lexical search; the pgvector tables
# stay dormant until an embedding provider is configured.
GROQ_API_KEY=
# GROQ_CHAT_MODEL=
# GROQ_BASE_URL=

# Scanned-PDF text conversion (server-only). The tutor stays on Groq; only
# image-only uploads are transcribed through Gemini vision, and the OCR
# origin is flagged on the material row forever.
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_OCR_MODEL=

# WhatsApp business number in international format, digits only.
# Official Saarthi Classes number. Also set this exact value in the Cloudflare
# dashboard (Environment Variables) so production builds bake it in.
NEXT_PUBLIC_WHATSAPP_NUMBER=919311230129
