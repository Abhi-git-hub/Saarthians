# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini AI tutor (server-only; never prefix with NEXT_PUBLIC_).
# Production must use the deployment platform's encrypted secret store.
GEMINI_API_KEY=
# Optional chat-model override. Default: gemini-2.5-flash (verified 2026-09-23).
GEMINI_MODEL=

# WhatsApp business number in international format, digits only.
# Official Saarthi Classes number. Also set this exact value in the Cloudflare
# dashboard (Environment Variables) so production builds bake it in.
NEXT_PUBLIC_WHATSAPP_NUMBER=919311230129
